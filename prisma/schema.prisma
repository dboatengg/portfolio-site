generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model GuestbookEntry {
  id         String   @id @default(cuid())
  provider   String
  providerId String
  name       String
  username   String
  image      String?
  message    String
  signature  String
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
}